{
    "name": "but-review",
    "displayName": "GitButler Review",
    "description": "Review GitButler stacks, place uncommitted changes, and track their pull requests",
    "version": "0.10.0",
    "publisher": "sophiamersmann",
    "engines": {
        "vscode": "^1.90.0"
    },
    "main": "./extension.js",
    "activationEvents": [
        "onStartupFinished"
    ],
    "contributes": {
        "colors": [
            {
                "id": "butReview.foreignHunkBackground",
                "description": "Tint over lines in the review pane that come from another applied branch, not the one being reviewed. Needs an alpha channel: it sits over the diff's own colours",
                "defaults": {
                    "dark": "#8957e533",
                    "light": "#8957e52b",
                    "highContrast": "#8957e54d"
                }
            },
            {
                "id": "butReview.ownHunkMark",
                "description": "Overview ruler mark for the hunks the branch under review put there — the same ones F7 walks",
                "defaults": {
                    "dark": "charts.blue",
                    "light": "charts.blue",
                    "highContrast": "charts.blue"
                }
            },
            {
                "id": "butReview.stackIcon",
                "description": "Icon colour for stack rows",
                "defaults": {
                    "dark": "charts.purple",
                    "light": "charts.purple",
                    "highContrast": "charts.purple"
                }
            },
            {
                "id": "butReview.branchIcon",
                "description": "Icon colour for branch rows",
                "defaults": {
                    "dark": "charts.blue",
                    "light": "charts.blue",
                    "highContrast": "charts.blue"
                }
            },
            {
                "id": "butReview.planTick",
                "description": "Icon colour for plan phase and task ticks",
                "defaults": {
                    "dark": "charts.purple",
                    "light": "charts.purple",
                    "highContrast": "charts.purple"
                }
            },
            {
                "id": "butReview.livePlanIcon",
                "description": "Icon colour for a plan whose branch is applied",
                "defaults": {
                    "dark": "charts.blue",
                    "light": "charts.blue",
                    "highContrast": "charts.blue"
                }
            },
            {
                "id": "butReview.prOpen",
                "description": "Icon colour for open pull requests",
                "defaults": {
                    "dark": "charts.blue",
                    "light": "charts.blue",
                    "highContrast": "charts.blue"
                }
            },
            {
                "id": "butReview.prDraft",
                "description": "Icon colour for draft pull requests",
                "defaults": {
                    "dark": "descriptionForeground",
                    "light": "descriptionForeground",
                    "highContrast": "descriptionForeground"
                }
            }
        ],
        "viewsContainers": {
            "activitybar": [
                {
                    "id": "butReview",
                    "title": "GitButler Review",
                    "icon": "icon-stack3.svg"
                },
                {
                    "id": "butReviewPlans",
                    "title": "Plans",
                    "icon": "icon-plans.svg"
                },
                {
                    "id": "butReviewPrs",
                    "title": "Pull Requests",
                    "icon": "icon-pull-request.svg"
                }
            ]
        },
        "views": {
            "butReview": [
                {
                    "id": "butReview.branches",
                    "name": "Branches",
                    "icon": "icon-stack3.svg"
                },
                {
                    "id": "butReview.uncommitted",
                    "name": "Changes",
                    "when": "butReview.hasUncommitted",
                    "icon": "icon-stack3.svg"
                }
            ],
            "butReviewPlans": [
                {
                    "id": "butReview.plans",
                    "name": "Plans",
                    "when": "butReview.hasPlans",
                    "icon": "icon-plans.svg"
                }
            ],
            "butReviewPrs": [
                {
                    "id": "butReview.prs",
                    "name": "Pull Requests",
                    "icon": "icon-pull-request.svg"
                }
            ]
        },
        "commands": [
            {
                "command": "butReview.absorb",
                "title": "Absorb All Changes",
                "category": "GitButler Review",
                "icon": "$(fold-up)"
            },
            {
                "command": "butReview.refresh",
                "title": "Refresh",
                "category": "GitButler Review",
                "icon": "$(refresh)"
            },
            {
                "command": "butReview.openFile",
                "title": "Open Changes",
                "category": "GitButler Review"
            },
            {
                "command": "butReview.openDirty",
                "title": "Open Change",
                "category": "GitButler Review"
            },
            {
                "command": "butReview.amendInto",
                "title": "Amend Into…",
                "category": "GitButler Review",
                "icon": "$(git-commit)"
            },
            {
                "command": "butReview.absorbOne",
                "title": "Absorb",
                "category": "GitButler Review",
                "icon": "$(fold-up)"
            },
            {
                "command": "butReview.discard",
                "title": "Discard Changes",
                "category": "GitButler Review",
                "icon": "$(discard)"
            },
            {
                "command": "butReview.renameStack",
                "title": "Rename Stack…",
                "category": "GitButler Review",
                "icon": "$(edit)"
            },
            {
                "command": "butReview.openUrl",
                "title": "Open Pull Request in Browser",
                "category": "GitButler Review",
                "icon": "$(globe)"
            },
            {
                "command": "butReview.copyUrl",
                "title": "Copy Pull Request Link",
                "category": "GitButler Review",
                "icon": "$(link)"
            },
            {
                "command": "butReview.diffAgainstCommit",
                "title": "Review Committed Changes Only",
                "category": "GitButler Review",
                "icon": "$(git-commit)"
            },
            {
                "command": "butReview.diffAgainstWorkspace",
                "title": "Review Against the Workspace",
                "category": "GitButler Review",
                "icon": "$(edit)"
            },
            {
                "command": "butReview.editHere",
                "title": "Open Working File",
                "category": "GitButler Review",
                "icon": "$(go-to-file)"
            },
            {
                "command": "butReview.viewAsList",
                "title": "View as List",
                "category": "GitButler Review",
                "icon": "$(list-flat)"
            },
            {
                "command": "butReview.viewAsTree",
                "title": "View as Tree",
                "category": "GitButler Review",
                "icon": "$(list-tree)"
            },
            {
                "command": "butReview.refreshPrs",
                "title": "Refresh Pull Requests",
                "category": "GitButler Review",
                "icon": "$(refresh)"
            },
            {
                "command": "butReview.nextChange",
                "title": "Next Change on This Branch",
                "category": "GitButler Review"
            },
            {
                "command": "butReview.prevChange",
                "title": "Previous Change on This Branch",
                "category": "GitButler Review"
            },
            {
                "command": "butReview.openPlan",
                "title": "Open Plan",
                "category": "GitButler Review"
            },
            {
                "command": "butReview.refreshPlans",
                "title": "Refresh Plans",
                "category": "GitButler Review",
                "icon": "$(refresh)"
            },
            {
                "command": "butReview.deletePlan",
                "title": "Delete Plan",
                "category": "GitButler Review",
                "icon": "$(trash)"
            },
            {
                "command": "butReview.newPlan",
                "title": "New Plan\u2026",
                "category": "GitButler Review",
                "icon": "$(add)"
            },
            {
                "command": "butReview.linkPlan",
                "title": "Link Plan\u2026",
                "category": "GitButler Review",
                "icon": "$(link)"
            }
        ],
        "keybindings": [
            {
                "command": "butReview.nextChange",
                "key": "f7",
                "when": "isInDiffEditor && butReview.reviewing"
            },
            {
                "command": "butReview.prevChange",
                "key": "shift+f7",
                "when": "isInDiffEditor && butReview.reviewing"
            }
        ],
        "menus": {
            "commandPalette": [
                {
                    "command": "butReview.nextChange",
                    "when": "butReview.reviewing"
                },
                {
                    "command": "butReview.prevChange",
                    "when": "butReview.reviewing"
                },
                {
                    "command": "butReview.openFile",
                    "when": "false"
                },
                {
                    "command": "butReview.openDirty",
                    "when": "false"
                },
                {
                    "command": "butReview.amendInto",
                    "when": "false"
                },
                {
                    "command": "butReview.absorbOne",
                    "when": "false"
                },
                {
                    "command": "butReview.discard",
                    "when": "false"
                },
                {
                    "command": "butReview.renameStack",
                    "when": "false"
                },
                {
                    "command": "butReview.openUrl",
                    "when": "false"
                },
                {
                    "command": "butReview.copyUrl",
                    "when": "false"
                },
                {
                    "command": "butReview.viewAsList",
                    "when": "false"
                },
                {
                    "command": "butReview.viewAsTree",
                    "when": "false"
                },
                {
                    "command": "butReview.editHere",
                    "when": "butReview.committedPane"
                },
                {
                    "command": "butReview.openPlan",
                    "when": "false"
                },
                {
                    "command": "butReview.deletePlan",
                    "when": "false"
                },
                {
                    "command": "butReview.linkPlan",
                    "when": "false"
                }
            ],
            "view/title": [
                {
                    "command": "butReview.diffAgainstCommit",
                    "when": "view == butReview.branches && !butReview.committed",
                    "group": "navigation@1"
                },
                {
                    "command": "butReview.diffAgainstWorkspace",
                    "when": "view == butReview.branches && butReview.committed",
                    "group": "navigation@1"
                },
                {
                    "command": "butReview.absorb",
                    "when": "view == butReview.uncommitted",
                    "group": "navigation"
                },
                {
                    "command": "butReview.refresh",
                    "when": "view == butReview.branches",
                    "group": "navigation@2"
                },
                {
                    "command": "butReview.refreshPrs",
                    "when": "view == butReview.prs",
                    "group": "navigation"
                },
                {
                    "command": "butReview.refreshPlans",
                    "when": "view == butReview.plans",
                    "group": "navigation"
                }
            ],
            "view/item/context": [
                {
                    "command": "butReview.linkPlan",
                    "when": "view == butReview.branches && viewItem =~ /^branch:/",
                    "group": "inline@1"
                },
                {
                    "command": "butReview.newPlan",
                    "when": "view == butReview.branches && viewItem =~ /^branch:/",
                    "group": "1_modify"
                },
                {
                    "command": "butReview.linkPlan",
                    "when": "view == butReview.plans && viewItem =~ /^plan(Stage)?$/",
                    "group": "1_modify"
                },
                {
                    "command": "butReview.deletePlan",
                    "when": "view == butReview.plans && viewItem == plan",
                    "group": "inline@1"
                },
                {
                    "command": "butReview.absorbOne",
                    "when": "view == butReview.uncommitted && viewItem =~ /^dirty(File|Hunk)$/",
                    "group": "inline@1"
                },
                {
                    "command": "butReview.amendInto",
                    "when": "view == butReview.uncommitted && viewItem =~ /(File|Hunk)$/",
                    "group": "1_modify"
                },
                {
                    "command": "butReview.discard",
                    "when": "view == butReview.uncommitted && viewItem =~ /(File|Hunk)$/",
                    "group": "2_discard"
                },
                {
                    "command": "butReview.copyUrl",
                    "when": "view == butReview.prs && viewItem == pr",
                    "group": "inline@1"
                },
                {
                    "command": "butReview.openUrl",
                    "when": "view == butReview.prs && viewItem == pr",
                    "group": "inline@2"
                },
                {
                    "command": "butReview.viewAsTree",
                    "when": "view == butReview.branches && viewItem =~ /^branch:list$/",
                    "group": "inline@2"
                },
                {
                    "command": "butReview.viewAsList",
                    "when": "view == butReview.branches && viewItem =~ /^branch:tree$/",
                    "group": "inline@2"
                },
                {
                    "command": "butReview.renameStack",
                    "when": "(view == butReview.branches && viewItem == stack) || (view == butReview.prs && viewItem == prStack)",
                    "group": "1_modify"
                }
            ],
            "editor/title": [
                {
                    "command": "butReview.editHere",
                    "when": "butReview.committedPane",
                    "group": "navigation"
                }
            ]
        },
        "configuration": {
            "title": "GitButler Review",
            "properties": {
                "butReview.ignoredChecks": {
                    "type": "array",
                    "items": {
                        "type": "string"
                    },
                    "default": [],
                    "markdownDescription": "CI checks to ignore when summarising a branch's status. Matched as case-insensitive substrings of the check title — useful for a noisy or slow job you never act on."
                },
                "butReview.botReviewers": {
                    "type": "array",
                    "items": {
                        "type": "string"
                    },
                    "default": [
                        "chatgpt-codex-connector",
                        "github-actions",
                        "copilot-pull-request-reviewer"
                    ],
                    "markdownDescription": "Reviewers whose approvals do not count. Logins ending in `[bot]` are always ignored; Codex reviews as `chatgpt-codex-connector` with no such suffix, hence this list."
                },
                "butReview.demoteBranches": {
                    "type": "array",
                    "items": {
                        "type": "string"
                    },
                    "default": [
                        "docs",
                        "debug"
                    ],
                    "markdownDescription": "Stacks whose every branch name contains one of these hyphen-separated tokens are sorted to the bottom, whatever their activity. Token match, so `docs` catches `my-docs` but not `docstring-fix`."
                },
                "butReview.fileLayout": {
                    "type": "string",
                    "enum": [
                        "list",
                        "tree"
                    ],
                    "default": "tree",
                    "enumDescriptions": [
                        "A flat list of files",
                        "A folder tree, one row per directory"
                    ],
                    "markdownDescription": "Default layout for a branch's changed files. Override per branch from the branch row."
                },
                "butReview.diffAgainst": {
                    "type": "string",
                    "enum": [
                        "workspace",
                        "commit"
                    ],
                    "enumDescriptions": [
                        "The right-hand pane is the file on disk: every applied branch's work and your uncommitted edits, marked up to say whose is whose. Editable.",
                        "The right-hand pane is the branch's own tip, so the diff is only what this branch changed against the one below it. Read-only."
                    ],
                    "default": "workspace",
                    "markdownDescription": "What the right-hand side of a review diff shows. Toggled per repository from the Branches title bar; this is the default for a repository you have not toggled."
                },
                "butReview.plansDirectory": {
                    "type": "string",
                    "default": "plans",
                    "description": "Where plan files live, relative to the repo root. Empty hides the Plans view."
                }
            }
        }
    },
    "license": "MIT",
    "repository": {
        "type": "git",
        "url": "https://github.com/sophiamersmann/gitbutler-review.git"
    },
    "scripts": {
        "test": "node smoke.js"
    }
}
